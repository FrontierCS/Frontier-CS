FROM {base_image}

RUN for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do \
        [ -f "$f" ] || continue; \
        if grep -q "developer.download.nvidia.com/compute/cuda" "$f"; then \
            sed -i 's|^[[:space:]]*deb |# disabled stale cuda repo: deb |' "$f"; \
        fi; \
    done && \
    apt-get update && \
    apt-get install -y --no-install-recommends python3 ca-certificates {judge_apt_packages_line} && \
    {judge_pip_install} \
    rm -rf /var/lib/apt/lists/*

WORKDIR /judge

COPY judge_server.py problem_evaluator.py task_config.json /judge/
RUN chmod 600 /judge/problem_evaluator.py

EXPOSE 8082
CMD ["python3", "/judge/judge_server.py"]
