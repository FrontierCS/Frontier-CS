+"""eigh_cusolver — torch.linalg.eigh (cuSOLVER syevd). Reference precision."""
+import torch
+
+
+def eigh(A: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """torch.linalg.eigh — cuSOLVER syevd. ~1e-7 residual."""
+    return torch.linalg.eigh(A)
