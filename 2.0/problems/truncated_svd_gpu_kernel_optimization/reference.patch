+"""Cost model shim for eigh.
+
+The full cost/roofline subsystem (``info.estimate`` / ``info.roofline``)
+and the approximate eigh variants (Halko / QDWH) are not part of this
+build. This module keeps the dispatcher's routed-variant label available
+via :func:`route_op_name` (re-exported from
+:mod:`tsvdlib._kernels.linalg.eigh.impl`); the exact cuSOLVER path is the
+only variant this build ships.
+"""
+from tsvdlib._kernels.linalg.eigh.impl import route_op_name as _route_op_name
+
+
+def _N(shape):
+    return shape[0] if isinstance(shape, (tuple, list)) else shape
+
+
+def recommend(shape, params=None, tol=None, dtype="float32", device="H100", **_):
+    """Mirror the dispatcher's choice (exact cuSOLVER in this build)."""
+    N = _N(shape)
+    K = (params or {}).get("K")
+    return {"variant": _route_op_name(N=N, K=K, tol=tol)}
